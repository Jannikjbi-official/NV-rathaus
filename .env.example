# ── Datenbank (Neon) ─────────────────────────────────────────────
# Pooled für die App, unpooled für Migrationen
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth.js ──────────────────────────────────────────────────────
# Zufälliger Wert: openssl rand -base64 32
AUTH_SECRET=
# Discord-Developer-Portal → OAuth2 (Redirect: https://<domain>/api/auth/callback/discord)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ── Discord-Server ───────────────────────────────────────────────
DISCORD_GUILD_ID=
# Rolle "Bürger" (Pflicht für das Bürgerkonto)
DISCORD_CITIZEN_ROLE_ID=
# Rollen mit Vollzugriff auf die Verwaltung, kommagetrennt (z. B. Owner,Admin)
DISCORD_ADMIN_ROLE_ID=
# Bot (im Server) für DMs bei Statusänderungen und Rollenabgleich
DISCORD_BOT_TOKEN=
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/KrfKASTHDp

# Öffentliche Adresse für Links in Discord-Nachrichten
NEXT_PUBLIC_SITE_URL=https://rathaus.nordverkehr.xyz

# Tablet im Spiel (FiveM-Ressource nv-tablet): gemeinsames Geheimnis, mind. 32 Zeichen.
# Derselbe Wert steht auf dem Spielserver als `set nv_rathaus_secret "…"`. Leer = aus.
FIVEM_LOGIN_SECRET=

# Nur lokal: Testzugang ohne Discord (wird in Produktion ignoriert)
AUTH_DEV_LOGIN=false
